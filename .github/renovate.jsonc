{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "enabledManagers": [
    "custom.regex"
  ],
  "extends": [
    "github>kachick/renovate-config-dprint#1.4.0"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "nix": {
    "enabled": false
  },
  "schedule": [
    "on Tuesday"
  ],
  "packageRules": [
    {
      "description": "General dprint plugins: monthly",
      "matchManagers": [
        "custom.regex"
      ],
      "extends": [
        "schedule:monthly"
      ]
    }
  ]
}
